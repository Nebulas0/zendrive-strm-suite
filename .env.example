# MQTT credentials (from your ClearStreamer/ZenDRIVE account)
MQTT_USERNAME=your-mqtt-user
MQTT_PASSWORD=your-mqtt-password

# Autoscan credentials (must match autoscan config.yml)
AUTOSCAN_PASSWORD=your-autoscan-password

# strm-bridge auth (must match what ZenLocalPoller sends)
STRM_BRIDGE_AUTH_PASS=your-bridge-password

# Emby API token
EMBY_TOKEN=your-emby-api-token

# Timezone
TZ=UTC
